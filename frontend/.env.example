# Frontend Environment Example
# Copy this to frontend/.env and set your local or production variables

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8000
# Production: VITE_API_BASE_URL=https://your-backend.onrender.com

# Firebase Authentication Configuration (Web App Client SDK)
# Obtain these values from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Initial Administrator Authorization Recognition
# Users signed in with this email are recognized as administrators in ScenoraEdits
VITE_ADMIN_EMAIL=admin@scenoraedits.com
